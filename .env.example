# ============================================================
# Campus Hands — Environment Variables
# Copy this file to .env and fill in every value.
# Never commit .env to git.
# ============================================================

PORT=3000
NODE_ENV=development

# ── Security ─────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_string_min_48_chars

# ── Admin ─────────────────────────────────────────────────────
# Secret code used to access the /admin.html panel.
# Change this to something long and random before deploying.
ADMIN_CODE=change_this_to_a_strong_secret

# ── Database ──────────────────────────────────────────────────
# Local dev: leave as default (creates database.sqlite in project root)
# Render:    set to /data/database.sqlite  (your persistent disk mount + filename)
DB_PATH=./database.sqlite

# ── File Uploads ──────────────────────────────────────────────
# Local dev: leave unset (defaults to <project-root>/uploads)
# Render:    set to /data/uploads  (same persistent disk as DB_PATH)
# UPLOAD_DIR=/data/uploads

# ── Email (SMTP) ──────────────────────────────────────────────
# Used for OTP codes and job-assigned notifications.
# Without this, OTP codes are printed to server logs (fine for dev/testing).
# Gmail: enable 2FA → create an App Password at
#   https://myaccount.google.com/apppasswords
# Use the 16-char app password as SMTP_PASS (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=Campus Hands <no-reply@campushands.app>

# ── App URL ───────────────────────────────────────────────────
# Local dev:   http://localhost:3000
# Render:      https://your-app-name.onrender.com
APP_URL=http://localhost:3000
