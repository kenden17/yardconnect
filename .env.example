# ============================================================
# Campus Hands — Environment Variables
# Copy this file to .env and fill in every value.
# Never commit .env to git.
# ============================================================

PORT=3000
NODE_ENV=development

# ── Security ─────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_string_min_48_chars

# ── Database ──────────────────────────────────────────────────
DB_PATH=./database.sqlite

# ── Email (SMTP) ──────────────────────────────────────────────
# Used for OTP codes and job assignment notifications.
# Gmail: enable 2FA, then create an App Password at
#   https://myaccount.google.com/apppasswords
# Use the 16-char app password as SMTP_PASS (no spaces).
# If not set, OTP codes are printed to the console in dev mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=Campus Hands <no-reply@campushands.app>

# ── App URL ───────────────────────────────────────────────────
# Local dev: http://localhost:3000
# Production: https://yourdomain.com
APP_URL=http://localhost:3000
